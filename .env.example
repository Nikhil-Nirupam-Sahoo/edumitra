# ---------------------------------------------------------------------------
# EduMitra — environment template
# Copy to `.env` (repo root or apps/server/.env) and fill in real values.
# NEVER commit a filled-in .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Server -----------------------------------------------------------------
# dev   -> sqlite file at DATA_DIR/edumitra.sqlite (zero external deps)
# prod  -> postgres (requires host/user/password below)
DB_DRIVER=dev
DATA_DIR=./data
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edumitra
DB_USER=edumitra
DB_PASSWORD=change-me-in-production

# --- Sync security ------------------------------------------------------------
# Shared secret for HMAC-SHA256 batch signing. MUST be set to a long random
# value in production — the server refuses to boot with the default when
# NODE_ENV=production. Generate: openssl rand -hex 32
SYNC_SIGNING_SECRET=dev-only-insecure-shared-secret
# Signatures older than this are rejected (replay protection).
SYNC_SIGNATURE_MAX_SKEW_MS=300000

# Server port. NOTE: must match VITE_API_BASE default so the client talks to it.
PORT=4600
SYNC_JOB_CONCURRENCY=4

# --- Optional integrations (server-side only) --------------------------------
# Both are read by the server and proxied to the browser. NEVER put these in
# client code or a VITE_* variable: anything prefixed VITE_ is inlined into the
# JS bundle and readable by every visitor.
#
# TRANSLATION — free by default, no key and no billing needed.
#
#   unset -> MyMemory (free, no signup). Translation of the UI *and* of lesson
#            content works out of the box.
#   set   -> Google Cloud Translation is preferred for better quality, but
#            requires a BILLING ACCOUNT, which is why it stays optional.
# Applies to both /api/v1/translate and /api/v1/translate/content.
GOOGLE_TRANSLATION_API_KEY=

# TEXT-TO-SPEECH — one free key (no card) for good Indian voices.
#
# Google Cloud TTS is the best voice but needs billing. Bhashini is the
# Government of India platform: free, and the only free source with an Odia
# voice (Microsoft/Edge has none, and `speechSynthesis` has none on most
# devices either). Free key: https://bhashini.gov.in/ulca
# Left unset, read-aloud falls back to the device's own voices.
BHASHINI_API_KEY=

# AI tutor — Help tab. Unset → /api/v1/support/status reports aiEnabled:false
# and the UI points the student at a mentor instead of faking a bot.
ANTHROPIC_API_KEY=
# Override if you want a different Claude model.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Redis (optional) ---------------------------------------------------------
# When set, sync jobs are queued through Redis instead of the in-process queue.
REDIS_URL=

# --- Client build (Vite) ------------------------------------------------------
# Relative path keeps the PWA working when hosted under any sub-path offline.
VITE_API_BASE=/api/v1
VITE_SYNC_SIGNING_SECRET=dev-only-insecure-shared-secret
