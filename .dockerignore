# Build context hygiene — everything below is rebuilt inside the image.
.git
**/node_modules
**/dist
# SQLite data directory (server local storage) — NOT the lesson content in
# apps/client/src/content/data, which must ship with the image. Scoped to the
# server's storage path and the repo root so content JSON is never excluded.
apps/server/data
data
*.db
*.sqlite
*.sqlite3
**/*.log
.env
**/.env